# Обязательные
LLM_API_KEY=sk-your-api-key-here
LLM_API_URL=https://api.openai.com/v1  # URL OpenAI-совместимого API

# Опциональные - если не указать подставятся дефолтные из docker-compose файла
# LLM
# LLM_MODEL=gpt-4o                   # Модель
# LLM_MAX_TOKENS=0                       # 0 = без ограничения, >0 = лимит токенов
# LLM_LEGACY_MAX_TOKENS=false            # true = max_tokens (старые API)
# LLM_TEMPERATURE=                       # пусто = дефолт модели, 0.0-2.0
# LLM_TIMEOUT=600                        # Жёсткий таймаут LLM-запроса (сек)
# LLM_SOFT_TIMEOUT=180                   # Мягкий таймаут — предложить продлить (сек)
# PDF_BATCH_SIZE=0                       # 0 = все страницы одним запросом
# MAX_FILE_SIZE_MB=1                     # Максимальный размер файла (МБ)

# Очереди
# QUEUE_SERVER_MAX_CONCURRENT=15         # Параллельных запросов к серверному LLM
# QUEUE_CUSTOM_MAX_CONCURRENT=15         # Параллельных запросов с пользовательским LLM
# QUEUE_ACTIVATION_DELAY=1.0             # Задержка между запусками из очереди (сек)

# Rate limiting
# RATE_LIMIT_REQUESTS=10                 # Максимум запросов за окно
# RATE_LIMIT_WINDOW=60                   # Окно в секундах

# Сервер
# WEB_PORT=8080                          # Порт веб-интерфейса

# Telegram-уведомления о сбоях OpenAI API (только для серверного LLM)
# TELEGRAM_NOTIFY_ENABLED=false                    # true = включить алерты в Telegram
# TELEGRAM_BOT_TOKEN=                              # Токен бота из @BotFather
# TELEGRAM_CHAT_ID=                                # ID чата (для групп: "-100…")
# TELEGRAM_MESSAGE_THREAD_ID=                      # ID топика в супергруппе с топиками (необязательно)
# TELEGRAM_API_URL=https://api.telegram.org        # Для тестов / локального Bot API
# TELEGRAM_PROXY=                                  # Прокси (Telegram заблокирован в РФ)
# TELEGRAM_REQUEST_TIMEOUT=10                      # Таймаут запроса к Bot API (сек)
# TELEGRAM_NOTIFY_COOLDOWN_SECONDS=900             # CRITICAL: 1 алерт на категорию в N сек
# TELEGRAM_NOTIFY_THRESHOLD_WINDOW_SECONDS=300     # WARNING: окно подсчёта событий
# TELEGRAM_NOTIFY_THRESHOLD_COUNT=5                # WARNING: триггер при N+ событий в окне
