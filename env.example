# Обязательные
LLM_API_KEY=sk-your-api-key-here

# LLM
# LLM_API_URL=https://api.openai.com/v1  # URL OpenAI-совместимого API
# LLM_MODEL=gpt-4o                   # Модель
# LLM_MAX_TOKENS=0                       # 0 = без ограничения, >0 = лимит токенов
# LLM_LEGACY_MAX_TOKENS=false            # true = max_tokens (старые API)
# LLM_TEMPERATURE=                       # пусто = дефолт модели, 0.0-2.0
# LLM_TIMEOUT=600                        # Жёсткий таймаут LLM-запроса (сек)
# LLM_SOFT_TIMEOUT=180                   # Мягкий таймаут — предложить продлить (сек)
# PDF_BATCH_SIZE=0                       # 0 = все страницы одним запросом
# MAX_FILE_SIZE_MB=1                     # Максимальный размер файла (МБ)

# Очереди
# QUEUE_SERVER_MAX_CONCURRENT=15         # Параллельных запросов к серверному LLM
# QUEUE_CUSTOM_MAX_CONCURRENT=15         # Параллельных запросов с пользовательским LLM
# QUEUE_ACTIVATION_DELAY=1.0             # Задержка между запусками из очереди (сек)

# Rate limiting
# RATE_LIMIT_REQUESTS=10                 # Максимум запросов за окно
# RATE_LIMIT_WINDOW=60                   # Окно в секундах

# Сервер
# WEB_PORT=8080                          # Порт веб-интерфейса
